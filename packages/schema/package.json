{
  "name": "@songnoi/schema",
  "version": "0.0.0",
  "description": "SongNoi form schema and defineField API (Zod).",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SongNoi/songnoi.git",
    "directory": "packages/schema"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "devDependencies": {
    "@songnoi/config": "workspace:*",
    "@types/node": "24.19.2",
    "eslint": "10.14.0",
    "tsdown": "0.23.5",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
