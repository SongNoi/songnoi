# Copy to .env and fill in. Never commit .env.

# ── Required ─────────────────────────────────────────────────────────────────────────────
# Public URL people use to reach SongNoi.
APP_URL=http://localhost:3000
# Password for the bundled Postgres (docker compose).
POSTGRES_PASSWORD=change-me
# Two DIFFERENT secrets, at least 32 characters each (ADR 0002). Generate with:
#   openssl rand -base64 32
ADMIN_AUTH_SECRET=
RESPONDENT_AUTH_SECRET=

# ── Local development (pnpm dev / tests against the compose Postgres) ───────────────────
DATABASE_URL=postgresql://songnoi:change-me@localhost:5432/songnoi
# Only for `pnpm db:check` (migration drift). Create it once: createdb songnoi_shadow
SHADOW_DATABASE_URL=postgresql://songnoi:change-me@localhost:5432/songnoi_shadow
# Integration tests (created once: createdb songnoi_test)
TEST_DATABASE_URL=postgresql://songnoi:change-me@localhost:5432/songnoi_test

# ── Optional ─────────────────────────────────────────────────────────────────────────────
LOG_LEVEL=info
WEB_PORT=3000

# ── Privacy: no tool telemetry leaves this machine (constitution §3) ───────────────────
NEXT_TELEMETRY_DISABLED=1
CHECKPOINT_DISABLE=1
TURBO_TELEMETRY_DISABLED=1
